{
  "manifest_version": 3,
  "name": "Oddity",
  "version": "1.0.0",
  "description": "Brainstorming AI agent for Google Docs",
  "permissions": [
    "storage",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles/tailwind.css"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
